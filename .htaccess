ErrorDocument 403 /app/Views/errors/403.php
ErrorDocument 404 /app/Views/errors/404.php
ErrorDocument 500 /app/Views/errors/500.php

# Public chat endpoint (enrollment-closed modal) must stay reachable without login.
<Files "chat_api.php">
    <IfModule mod_authz_core.c>
        Require all granted
    </IfModule>
    <IfModule !mod_authz_core.c>
        Order allow,deny
        Allow from all
    </IfModule>
</Files>
